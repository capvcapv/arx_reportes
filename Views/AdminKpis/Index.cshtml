@model IReadOnlyList<KpiDefinition>
@{
    ViewData["Title"] = "Administrar KPI";
    var connections = ViewBag.Connections as Dictionary<Guid, string> ?? new();
}
<div class="page-heading">
    <div><span class="eyebrow">TABLERO</span><h1>Indicadores KPI</h1><p>Valores clave que aparecen antes del catálogo de reportes.</p></div>
    <a class="btn btn-primary" asp-action="Create"><span class="btn-icon" aria-hidden="true">＋</span><span>Nuevo KPI</span></a>
</div>
<div class="reorder-hint mb-3"><span class="drag-symbol">⋮⋮</span> Arrastra los KPI para cambiar su orden en el inicio. <span id="order-status" aria-live="polite"></span></div>
<div class="panel table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th class="drag-column"><span class="visually-hidden">Ordenar</span></th><th>Indicador</th><th>Conexión</th><th>Formato</th><th>Caché</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody id="sortable-kpis">
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-5">No hay KPI configurados.</td></tr> }
    @foreach (var item in Model)
    {
        <tr data-kpi-id="@item.Id">
            <td class="drag-column"><button class="drag-handle" type="button" draggable="true" title="Arrastrar para ordenar" aria-label="Mover @item.Name">⋮⋮</button></td>
            <td><strong>@item.Name</strong><small class="d-block text-muted">@(item.Description ?? item.ValueColumn)</small></td>
            <td>@(connections.GetValueOrDefault(item.ConnectionId) ?? "Conexión no disponible")</td>
            <td>@DisplayFormat(item.Format)</td>
            <td>@(item.CacheMinutes == 0 ? "Sin caché" : $"{item.CacheMinutes} min")</td>
            <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Visible" : "Inactivo")</span></td>
            <td class="admin-actions-cell"><div class="admin-actions"><a class="btn btn-sm btn-outline-success" asp-controller="Home" asp-action="Index" asp-route-refreshKpis="true"><span class="btn-icon" aria-hidden="true">↗</span><span>Ver inicio</span></a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id"><span class="btn-icon" aria-hidden="true">✎</span><span>Editar</span></a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar este KPI?')"><button class="btn btn-sm btn-outline-danger"><span class="btn-icon" aria-hidden="true">×</span><span>Eliminar</span></button></form></div></td>
        </tr>
    }
    </tbody>
</table></div>
<form id="reorder-form" class="d-none" asp-action="Reorder" method="post"></form>

@functions {
    static string DisplayFormat(KpiValueFormat format) => format switch
    {
        KpiValueFormat.Numero => "Número",
        KpiValueFormat.Porcentaje => "Porcentaje",
        KpiValueFormat.Moneda => "Moneda",
        _ => "Texto"
    };
}

@section Scripts {
    <script>
        const kpiRows=document.getElementById('sortable-kpis');
        const orderStatus=document.getElementById('order-status');
        const reorderForm=document.getElementById('reorder-form');
        let draggedRow=null;

        kpiRows?.querySelectorAll('.drag-handle').forEach(handle=>{
            handle.addEventListener('dragstart',event=>{
                draggedRow=handle.closest('tr');
                draggedRow.classList.add('is-dragging');
                event.dataTransfer.effectAllowed='move';
                event.dataTransfer.setData('text/plain',draggedRow.dataset.kpiId);
            });
            handle.addEventListener('dragend',()=>{
                draggedRow?.classList.remove('is-dragging');
                draggedRow=null;
                kpiRows.querySelectorAll('tr').forEach(row=>row.classList.remove('drag-target'));
            });
        });

        kpiRows?.addEventListener('dragover',event=>{
            if(!draggedRow)return;
            event.preventDefault();
            const target=event.target.closest('tr[data-kpi-id]');
            if(!target||target===draggedRow)return;
            const bounds=target.getBoundingClientRect();
            kpiRows.insertBefore(draggedRow,event.clientY>bounds.top+bounds.height/2?target.nextSibling:target);
            kpiRows.querySelectorAll('tr').forEach(row=>row.classList.remove('drag-target'));
            target.classList.add('drag-target');
        });

        kpiRows?.addEventListener('drop',async event=>{
            if(!draggedRow)return;
            event.preventDefault();
            orderStatus.className='saving';
            orderStatus.textContent='Guardando orden…';
            const formData=new FormData(reorderForm);
            kpiRows.querySelectorAll('tr[data-kpi-id]').forEach(row=>formData.append('ids',row.dataset.kpiId));
            try {
                const response=await fetch('@Url.Action("Reorder", "AdminKpis")',{method:'POST',body:formData,headers:{'X-Requested-With':'XMLHttpRequest'}});
                const result=await response.json();
                if(!response.ok||!result.success)throw new Error(result.message||'No fue posible guardar el orden.');
                orderStatus.className='saved';
                orderStatus.textContent='Orden guardado';
                setTimeout(()=>orderStatus.textContent='',2200);
            } catch(error) {
                orderStatus.className='failed';
                orderStatus.textContent=error.message;
            }
        });
    </script>
}
