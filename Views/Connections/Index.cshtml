@model IReadOnlyList<ConnectionDefinition>
@{ ViewData["Title"] = "Conexiones"; }
<div class="page-heading">
    <div><span class="eyebrow">CONFIGURACIÓN</span><h1>Conexiones SQL Server</h1><p>Instancias disponibles para los reportes.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Nueva conexión</a>
</div>
<div class="panel table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Nombre</th><th>Servidor</th><th>Base de datos</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-5">No hay conexiones configuradas.</td></tr> }
    @foreach (var item in Model)
    {
        <tr><td class="fw-semibold">@item.Name</td><td><code>@item.Server</code></td><td>@item.Database</td><td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activa" : "Inactiva")</span></td>
        <td class="text-end text-nowrap"><form class="d-inline" asp-action="Test" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-success">Probar</button></form> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a> <form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar esta conexión?')"><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></td></tr>
    }
    </tbody>
</table></div>
