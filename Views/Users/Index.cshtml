@model IReadOnlyList<UserDefinition>
@{ ViewData["Title"] = "Usuarios"; }
<div class="page-heading">
    <div><span class="eyebrow">SEGURIDAD</span><h1>Usuarios</h1><p>Controla quién puede ingresar y qué información puede consultar.</p></div>
    <a class="btn btn-primary" asp-action="Create"><span class="btn-icon" aria-hidden="true">＋</span><span>Nuevo usuario</span></a>
</div>
<div class="panel table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Nombre</th><th>Usuario</th><th>KPI</th><th>Gráficas</th><th>Reportes</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-5">No hay usuarios registrados.</td></tr> }
    @foreach (var item in Model)
    {
        <tr><td class="fw-semibold">@item.DisplayName</td><td><code>@item.UserName</code></td><td>@item.AllowedKpiIds.Count</td><td>@item.AllowedChartIds.Count</td><td>@item.AllowedReportIds.Count</td><td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span></td>
        <td class="admin-actions-cell"><div class="admin-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id"><span class="btn-icon" aria-hidden="true">✎</span><span>Permisos</span></a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar este usuario? Ya no podrá iniciar sesión.')"><button class="btn btn-sm btn-outline-danger"><span class="btn-icon" aria-hidden="true">×</span><span>Eliminar</span></button></form></div></td></tr>
    }
    </tbody>
</table></div>
